+local Cleanup = getgenv().__GelatekCleanup or { conns = {}, objs = {} }
+getgenv().__GelatekCleanup = Cleanup
+local function Conn(signal, handler)
+	local connection = signal:Connect(handler)
+	table.insert(Cleanup.conns, connection)
+	return connection
+end
+local function Track(object)
+	table.insert(Cleanup.objs, object)
+	return object
